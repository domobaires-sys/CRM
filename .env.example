# Base PostgreSQL (local, Supabase o Neon)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/domo_crm"

# Captura de leads (ver docs/captura-de-leads.md)
# Texto inventado por vos; se repite al configurar el webhook en developers.facebook.com
META_VERIFY_TOKEN="elegi-un-texto-largo"
# App de Meta > Configuración > Básica > Clave secreta de la app
META_APP_SECRET=""
# Token de la Página de Facebook con permiso leads_retrieval (para Lead Ads)
META_PAGE_ACCESS_TOKEN=""
META_GRAPH_VERSION="v23.0"
# Sitios que pueden enviar el formulario de contacto, separados por coma
WEB_FORM_ALLOWED_ORIGINS="https://domobaires.com,https://www.domobaires.com"
CAPTURE_BASE_PATH="/api"
